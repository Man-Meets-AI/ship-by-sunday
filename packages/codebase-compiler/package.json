{
	"name": "@shipbysunday/codebase-compiler",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts"
	},
	"scripts": {
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src tests vitest.config.ts",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"jszip": "^3.10.2",
		"shadcn": "^4.21.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	}
}
