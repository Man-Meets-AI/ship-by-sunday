{
	"name": "@shipbysunday/codebase-compiler",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts"
	},
	"scripts": {
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src tests vitest.config.ts",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"jszip": "^3.10.1",
		"shadcn": "^4.7.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.5"
	}
}
