{
	"name": "@shipbysunday/blueprint-compiler",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts"
	},
	"scripts": {
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src tests vitest.config.ts",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"jszip": "^3.10.1",
		"shadcn": "^4.5.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.62.0",
		"typescript": "5.9.3",
		"vitest": "^4.1.0"
	}
}
