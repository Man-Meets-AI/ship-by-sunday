{
	"name": "ship-by-sunday",
	"version": "0.1.0",
	"private": false,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"ship-by-sunday": "./dist/cli.js",
		"shipbysunday": "./dist/cli.js"
	},
	"files": [
		"dist/cli.js"
	],
	"scripts": {
		"ship-by-sunday": "jiti src/cli.ts",
		"execplan:build": "jiti src/cli.ts execplan build",
		"program:run": "jiti src/cli.ts program run",
		"program:run-slice": "jiti src/cli.ts program run-slice",
		"build": "esbuild ./src/cli.ts --bundle --platform=node --format=esm --target=node20 --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outfile=dist/cli.js && chmod +x dist/cli.js",
		"prepack": "npm run build --silent",
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src tests vitest.config.ts",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts",
		"worker:compatibility-smoke": "jiti tests/worker-install-compatibility-smoke.ts",
		"package:smoke": "jiti tests/package-smoke.ts"
	},
	"dependencies": {
		"@effect/platform": "^0.97.2",
		"@effect/platform-node": "^0.107.0",
		"effect": "^3.21.4"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"esbuild": "0.28.2",
		"jiti": "^2.7.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	}
}
