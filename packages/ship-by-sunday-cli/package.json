{
	"name": "@manmeetsai/ship-by-sunday-cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Repo-local Ship by Sunday CLI for packet intake and starter snapshot generation.",
	"bin": {
		"sbs": "./src/cli.ts"
	},
	"scripts": {
		"sbs": "bun run src/cli.ts",
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src tests vitest.config.ts",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.gitignore --check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"@manmeetsai/packet-compiler": "workspace:*",
		"@shipbysunday/packet-presentation": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.56.0",
		"typescript": "5.9.3",
		"vitest": "^4.1.0"
	}
}
