{
	"name": "ship-by-sunday-site",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.5",
	"workspaces": [
		"apps/web",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/web dev",
		"dev:core": "bun run --cwd apps/web dev:core",
		"dev:core:webpack": "bun run --cwd apps/web dev:core:webpack",
		"dev:web": "bun run --cwd apps/web dev:web",
		"dev:convex": "bun run --cwd apps/web dev:convex",
		"dev:stripe": "bun run --cwd apps/web dev:stripe",
		"dev:full": "bun run --cwd apps/web dev:full",
		"build": "bun run --cwd apps/web build",
		"start": "bun run --cwd apps/web start",
		"typecheck": "bun run typecheck:app && bun run typecheck:packages",
		"typecheck:app": "bun run --cwd apps/web typecheck",
		"typecheck:packages": "bun run --cwd packages/codebase-compiler typecheck && bun run --cwd packages/codebase-presentation typecheck && bun run --cwd packages/local-runner typecheck && bun run --cwd packages/telegram-chat-widget typecheck",
		"lint": "bun run lint:app && bun run lint:packages",
		"lint:app": "bun run scripts/static-analysis/unknown-boundary-lint.ts && bun run --cwd apps/web lint",
		"lint:packages": "bun run --cwd packages/codebase-compiler lint && bun run --cwd packages/codebase-presentation lint && bun run --cwd packages/local-runner lint && bun run --cwd packages/telegram-chat-widget lint",
		"lint:fix": "bun run --cwd apps/web lint:fix",
		"markdown:lint": "bun run scripts/markdown-metadata/run-lint.ts",
		"public-readiness:lint": "bun run scripts/public-readiness/run-lint.ts",
		"posthog:proof": "node scripts/observability/posthog-proof.mjs",
		"security:lockfile-release-age": "bun run scripts/security/check-lockfile-release-age.ts",
		"docs:generated:check": "diff -qr docs/openai docs/generated/openai-codebase && diff -qr docs/ship-by-sunday docs/generated/ship-by-sunday-codebase",
		"plans:lint": "bun run scripts/exec-plan/run-lint.ts",
		"programs:lint": "bun run scripts/programs/run-lint.ts",
		"format": "bun run --cwd apps/web format",
		"format:check": "bun run --cwd apps/web format:check",
		"test:unit": "bun run --cwd apps/web test:unit",
		"test:contracts": "bun run --cwd apps/web test:contracts",
		"test:smoke": "bun run --cwd apps/web test:smoke",
		"test:packages": "bun run --cwd packages/codebase-compiler test && bun run --cwd packages/codebase-presentation test && bun run --cwd packages/local-runner test && bun run --cwd packages/telegram-chat-widget test",
		"test:scripts": "bun test scripts/programs/program-lint.test.ts scripts/security/check-lockfile-release-age.test.ts",
		"test:package-smoke": "bun run --cwd packages/local-runner build && bun run --cwd packages/local-runner package:smoke",
		"test:worker-compatibility-smoke": "bun run --cwd packages/local-runner worker:compatibility-smoke",
		"test:integration": "bun run --cwd apps/web test:integration",
		"test:integration:node": "bun run --cwd apps/web test:integration:node",
		"test:integration:ui": "bun run --cwd apps/web test:integration:ui",
		"test:coverage:critical": "bun run --cwd apps/web test:coverage:critical",
		"test:e2e:sandbox": "bun run --cwd apps/web test:e2e:sandbox",
		"test:e2e:sandbox:billing-integration": "bun run --cwd apps/web test:e2e:sandbox:billing-integration",
		"test:e2e:sandbox:default-ship": "bun run --cwd apps/web test:e2e:sandbox:default-ship",
		"test:e2e:local-auth": "bun run --cwd apps/web test:e2e:local-auth",
		"test:e2e:local-auth:default-ship": "bun run --cwd apps/web test:e2e:local-auth:default-ship",
		"check:fast": "bun run lint && bun run format:check",
		"check:source": "bun run lint && bun run format:check && bun run typecheck:packages && bun run test:unit && bun run test:contracts && bun run test:packages && bun run test:scripts && bun run test:coverage:critical && bun run test:package-smoke && bun run test:worker-compatibility-smoke && DISABLE_POSTHOG_SOURCE_MAP_UPLOAD=1 bun run build",
		"check": "bun run check:source && bun run test:integration",
		"video:cut:setup": "bun run --cwd apps/web video:cut:setup",
		"video:cut": "bun run --cwd apps/web video:cut",
		"video:transcripts:setup": "bun run --cwd apps/web video:transcripts:setup",
		"video:transcripts": "bun run --cwd apps/web video:transcripts",
		"video:lessons": "bun run --cwd apps/web video:lessons",
		"video:status": "bun run --cwd apps/web video:status",
		"video:publish": "bun run --cwd apps/web video:publish",
		"stripe:create-product": "bun run --cwd apps/web stripe:create-product",
		"stripe:listen:dev": "bun run --cwd apps/web stripe:listen:dev",
		"stripe:webhook:sync": "bun run --cwd apps/web stripe:webhook:sync",
		"stripe:dev:doctor": "bun run --cwd apps/web stripe:dev:doctor",
		"stripe:dev:verify": "bun run --cwd apps/web stripe:dev:verify",
		"stripe:hosted:verify:dev-card": "bun run --cwd apps/web stripe:hosted:verify:dev-card",
		"auth:dev:doctor": "bun run --cwd apps/web auth:dev:doctor",
		"review:handoff:doctor": "bun run --cwd apps/web review:handoff:doctor",
		"clerk:test-user:check": "bun run --cwd apps/web clerk:test-user:check",
		"clerk:test-user:create": "bun run --cwd apps/web clerk:test-user:create",
		"clerk:test-user:check:entitled": "bun run --cwd apps/web clerk:test-user:check:entitled",
		"clerk:test-user:create:entitled": "bun run --cwd apps/web clerk:test-user:create:entitled",
		"clerk:test-user:prepare:entitled": "bun run --cwd apps/web clerk:test-user:prepare:entitled",
		"engineering:intake:runtime": "node apps/web/scripts/export-runtime-intake.mjs",
		"release:manifest:check": "node scripts/release/validate-release-manifest.mjs --manifest=release.json --changelog=CHANGELOG.md",
		"release:notes:build": "node scripts/release/build-release-notes.mjs --manifest=release.json --changelog=CHANGELOG.md",
		"release:evidence:build": "node scripts/release/build-release-evidence.mjs --manifest=release.json --output=tmp/release-evidence.v1.json --dry-run",
		"release:billing:doctor": "bun run --cwd apps/web release:billing:doctor",
		"release:proof:dev-payment": "bun run stripe:hosted:verify:dev-card -- --base-url=https://dev.man-meets-ai.com",
		"release:convex:sync-hosted-dev": "node scripts/release/sync-hosted-convex-dev.mjs",
		"release:personas:prepare": "node scripts/release/prepare-release-personas.mjs prepare",
		"release:personas:reset": "node scripts/release/prepare-release-personas.mjs reset",
		"release:proof": "node scripts/release/run-release-proof.mjs",
		"release:proof:default-ship": "bun run release:proof -- --proof=default_ship",
		"release:proof:billing-integration": "bun run release:proof -- --proof=billing_integration"
	}
}
