{
	"name": "ship-by-sunday-site",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.5",
	"scripts": {
		"dev": "bun run dev:full",
		"dev:core": "concurrently -k -n nextjs,convex -c auto \"bun run dev:web:only\" \"bun run dev:convex\"",
		"dev:core:webpack": "concurrently -k -n nextjs,convex -c auto \"bun run dev:web:webpack\" \"bun run dev:convex\"",
		"dev:web": "bun run dev",
		"dev:web:only": "next dev",
		"dev:web:webpack": "next dev --webpack",
		"dev:web:raw": "next dev",
		"dev:convex": "convex dev",
		"dev:stripe": "node scripts/dev-stripe-listen-ready.mjs",
		"dev:full": "concurrently -k -n nextjs,convex,stripe -c auto \"bun run dev:web:only\" \"bun run dev:convex\" \"bun run dev:stripe\"",
		"auth:dev:doctor": "node --env-file=.env.local scripts/local-clerk-convex-auth-doctor.mjs",
		"review:handoff:doctor": "bun scripts/review-handoff-doctor.ts",
		"build": "node scripts/run-next-build-serialized.mjs",
		"start": "next start",
		"typecheck": "node scripts/run-next-build-serialized.mjs",
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings .",
		"lint:fix": "oxlint -c ../../.oxlintrc.json --fix --fix-suggestions .",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path .gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path .gitignore --check .",
		"test:unit": "vitest run --project unit",
		"test:contracts": "vitest run --project contracts",
		"test:smoke": "bun run test:contracts",
		"test:integration": "vitest run --project integration --project integration-ui",
		"test:integration:node": "vitest run --project integration",
		"test:integration:ui": "vitest run --project integration-ui",
		"test:coverage:critical": "vitest run --project unit --project integration --project integration-ui tests/unit/codex-route-helpers.test.ts tests/unit/course-access.test.ts tests/unit/checkout-session.test.ts tests/unit/not-found-screen.test.ts tests/unit/observability-*.test.ts tests/integration/codex-route-handlers.test.ts tests/integration/stripe-checkout-route.test.ts tests/integration-ui/error-boundary-screen.test.tsx --coverage.enabled true",
		"test:e2e:sandbox": "playwright test --project=sandbox-e2e",
		"test:e2e:sandbox:default-ship": "playwright test --project=sandbox-e2e --grep @default_ship",
		"test:e2e:sandbox:billing-integration": "playwright test --project=sandbox-e2e --grep @billing_integration",
		"test:e2e:local-auth": "E2E_RUN_LOCAL_AUTH=1 playwright test --project=sandbox-e2e",
		"test:e2e:local-auth:default-ship": "E2E_RUN_LOCAL_AUTH=1 playwright test --project=sandbox-e2e --grep @default_ship",
		"playwright:install": "playwright install --with-deps chromium",
		"screenshots:landing": "node scripts/capture-landing-screenshots.mjs",
		"check": "bun run lint && bun run format:check && bun run test:unit && bun run test:contracts && bun run test:integration && bun run test:coverage:critical && bun run build",
		"video:cut:setup": "node scripts/video-cut-setup.mjs",
		"video:cut": "node --env-file=.env.local scripts/video-cut.mjs",
		"video:prepare:color": "node --env-file=.env.local scripts/video-prepare-color.mjs",
		"video:grade": "node scripts/video-grade.mjs",
		"video:upload:bunny": "node --env-file=.env.local scripts/video-upload-bunny.mjs",
		"video:transcripts:setup": "bun run video:cut:setup",
		"video:transcripts": "node scripts/video-transcripts.mjs",
		"video:lessons": "node scripts/video-lessons.mjs",
		"video:verify": "bun scripts/video-verify.ts",
		"video:status": "node --env-file=.env.local scripts/video-status.mjs",
		"video:publish": "node --env-file=.env.local scripts/video-publish.mjs",
		"stripe:create-product": "node --env-file=.env.local scripts/create-stripe-product.mjs",
		"stripe:listen:dev": "node --env-file=.env.local scripts/local-stripe-webhook.mjs listen",
		"stripe:webhook:sync": "node --env-file=.env.local scripts/local-stripe-webhook.mjs sync",
		"stripe:dev:doctor": "node --env-file=.env.local scripts/local-stripe-doctor.mjs",
		"stripe:dev:verify": "node --env-file=.env.local scripts/verify-local-stripe-checkout.mjs",
		"release:billing:doctor": "node scripts/release-billing-doctor.mjs",
		"stripe:env:verify": "bun scripts/verify-managed-stripe-env.ts",
		"stripe:hosted:verify:dev": "node --env-file=.env.local scripts/verify-hosted-stripe-checkout.mjs",
		"stripe:hosted:verify:dev-card": "node --env-file=.env.local scripts/verify-dev-stripe-card-payment.mjs",
		"stripe:hosted:verify": "node --env-file=.env.production scripts/verify-hosted-stripe-checkout.mjs",
		"clerk:test-user:check": "node --env-file=.env.local scripts/ensure-clerk-test-user.mjs check",
		"clerk:test-user:create": "node --env-file=.env.local scripts/ensure-clerk-test-user.mjs create",
		"clerk:test-user:check:entitled": "CLERK_TEST_USER_SCOPE=ship-by-sunday-clerk-entitled node --env-file=.env.local scripts/ensure-clerk-test-user.mjs check",
		"clerk:test-user:create:entitled": "CLERK_TEST_USER_SCOPE=ship-by-sunday-clerk-entitled node --env-file=.env.local scripts/ensure-clerk-test-user.mjs create",
		"clerk:test-user:prepare:entitled": "CLERK_TEST_USER_SCOPE=ship-by-sunday-clerk-entitled node --env-file=.env.local scripts/ensure-clerk-entitled-test-user.mjs"
	},
	"dependencies": {
		"@clerk/backend": "^3.2.2",
		"@clerk/nextjs": "^7.2.7",
		"@clerk/ui": "^1.2.3",
		"@hugeicons/core-free-icons": "^4.1.1",
		"@hugeicons/react": "^1.1.6",
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "16.2.0",
		"@phosphor-icons/react": "^2.1.10",
		"@posthog/nextjs-config": "^1.9.16",
		"@remixicon/react": "^4.9.0",
		"@remotion/player": "^4.0.455",
		"@shipbysunday/codebase-compiler": "workspace:*",
		"@shipbysunday/codebase-presentation": "workspace:*",
		"@shipbysunday/telegram-chat-widget": "workspace:*",
		"@stripe/react-stripe-js": "^6.3.0",
		"@stripe/stripe-js": "^9.7.0",
		"@tabler/icons-react": "^3.44.0",
		"@tanstack/react-form": "^1.29.1",
		"@types/mdx": "^2.0.13",
		"@xyflow/react": "^12.10.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "1.1.1",
		"convex": "^1.37.0",
		"html-to-image": "1.11.13",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.11.0",
		"motion": "^12.40.0",
		"next": "16.2.0",
		"next-themes": "^0.4.6",
		"posthog-js": "^1.372.6",
		"posthog-node": "^5.33.0",
		"radix-ui": "^1.4.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-syntax-highlighter": "^16.1.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remotion": "^4.0.455",
		"shadcn": "^4.5.0",
		"sonner": "^2.0.7",
		"stripe": "^20.4.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@clerk/testing": "^2.0.26",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/postcss": "4.3.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "25.9.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitest/coverage-v8": "^4.1.5",
		"concurrently": "^9.2.1",
		"jsdom": "^29.1.1",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.56.0",
		"postcss": "8.5.15",
		"tailwindcss": "4.3.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.0"
	}
}
