{
	"name": "ship-by-sunday-site",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.5",
	"scripts": {
		"dev": "concurrently -k -n web,convex -c auto \"bun run dev:web\" \"bun run dev:convex\"",
		"dev:web": "next dev",
		"dev:convex": "convex dev",
		"dev:stripe": "node scripts/dev-stripe-listen-ready.mjs",
		"dev:full": "concurrently -k -n web,convex,stripe -c auto \"bun run dev:web\" \"bun run dev:convex\" \"bun run dev:stripe\"",
		"build": "next build",
		"start": "next start",
		"typecheck": "next build",
		"lint": "oxlint -c ../../.oxlintrc.json --deny-warnings .",
		"lint:fix": "oxlint -c ../../.oxlintrc.json --fix --fix-suggestions .",
		"format": "oxfmt -c ../../.oxfmtrc.json --ignore-path .gitignore .",
		"format:check": "oxfmt -c ../../.oxfmtrc.json --ignore-path .gitignore --check .",
		"test:unit": "vitest run --project unit",
		"test:contracts": "vitest run --project contracts",
		"test:smoke": "bun run test:contracts",
		"test:integration": "vitest run --project integration --project integration-ui",
		"test:integration:node": "vitest run --project integration",
		"test:integration:ui": "vitest run --project integration-ui",
		"test:coverage:critical": "vitest run --project unit --project integration --project integration-ui tests/unit/codex-route-helpers.test.ts tests/unit/course-access.test.ts tests/unit/checkout-session.test.ts tests/unit/not-found-screen.test.ts tests/unit/observability-*.test.ts tests/integration/codex-route-handlers.test.ts tests/integration/stripe-checkout-route.test.ts tests/integration-ui/error-boundary-screen.test.tsx --coverage.enabled true",
		"test:browser-smoke": "PLAYWRIGHT_USE_LOCAL_SERVER=1 playwright test --project=browser-smoke",
		"test:e2e:sandbox": "playwright test --project=sandbox-e2e",
		"playwright:install": "playwright install --with-deps chromium",
		"check": "bun run lint && bun run format:check && bun run test:unit && bun run test:contracts && bun run test:integration && bun run test:coverage:critical && bun run build",
		"video:cut:setup": "node scripts/video-cut-setup.mjs",
		"video:cut": "node --env-file=.env.local scripts/video-cut.mjs",
		"video:transcripts:setup": "bun run video:cut:setup",
		"video:transcripts": "node scripts/video-transcripts.mjs",
		"video:lessons": "node scripts/video-lessons.mjs",
		"video:status": "node --env-file=.env.local scripts/video-status.mjs",
		"video:publish": "node --env-file=.env.local scripts/video-publish.mjs",
		"stripe:create-product": "node --env-file=.env.local scripts/create-stripe-product.mjs",
		"stripe:listen:dev": "node --env-file=.env.local scripts/local-stripe-webhook.mjs listen",
		"stripe:webhook:sync": "node --env-file=.env.local scripts/local-stripe-webhook.mjs sync",
		"stripe:dev:doctor": "node --env-file=.env.local scripts/local-stripe-doctor.mjs",
		"stripe:dev:verify": "node --env-file=.env.local scripts/verify-local-stripe-checkout.mjs",
		"starter-repo:pending": "node --env-file=.env.local scripts/starter-repo-access.mjs pending",
		"starter-repo:invite": "node --env-file=.env.local scripts/starter-repo-access.mjs invite",
		"starter-repo:sync": "node --env-file=.env.local scripts/starter-repo-access.mjs sync",
		"starter-repo:reset": "node --env-file=.env.local scripts/starter-repo-access.mjs reset",
		"clerk:test-user:check": "node --env-file=.env.local scripts/ensure-clerk-test-user.mjs check",
		"clerk:test-user:create": "node --env-file=.env.local scripts/ensure-clerk-test-user.mjs create",
		"clerk:test-user:check:entitled": "CLERK_TEST_USER_SCOPE=ship-by-sunday-clerk-entitled node --env-file=.env.local scripts/ensure-clerk-test-user.mjs check",
		"clerk:test-user:create:entitled": "CLERK_TEST_USER_SCOPE=ship-by-sunday-clerk-entitled node --env-file=.env.local scripts/ensure-clerk-test-user.mjs create",
		"clerk:test-user:prepare:entitled": "CLERK_TEST_USER_SCOPE=ship-by-sunday-clerk-entitled node --env-file=.env.local scripts/ensure-clerk-entitled-test-user.mjs"
	},
	"dependencies": {
		"@manmeetsai/packet-compiler": "workspace:*",
		"@base-ui/react": "^1.3.0",
		"@clerk/backend": "^3.2.2",
		"@clerk/nextjs": "^7.0.4",
		"@clerk/ui": "^1.2.3",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^10.0.0-alpha.2",
		"@tabler/icons-react": "^3.40.0",
		"@tanstack/react-form": "^1.28.5",
		"@tsparticles/engine": "^3.9.1",
		"@tsparticles/react": "^3.0.0",
		"@tsparticles/slim": "^3.9.1",
		"@xyflow/react": "^12.10.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cobe": "^2.0.1",
		"convex": "^1.34.0",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.6.0",
		"heat-graph": "^0.0.1",
		"html-to-image": "1.11.13",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.577.0",
		"motion": "^12.38.0",
		"next": "16.2.0",
		"next-themes": "^0.4.6",
		"nextra": "^4.6.1",
		"nextra-theme-docs": "^4.6.1",
		"radix-ui": "^1.4.3",
		"react": "19.2.4",
		"react-day-picker": "^9.14.0",
		"react-dom": "19.2.4",
		"react-resizable-panels": "^4.7.3",
		"react-syntax-highlighter": "^16.1.1",
		"recharts": "2.15.4",
		"shadcn": "^4.0.8",
		"sonner": "^2.0.7",
		"stripe": "^20.4.1",
		"tailwind-merge": "^3.5.0",
		"three": "^0.183.2",
		"three-globe": "^2.45.1",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@tailwindcss/postcss": "4.2.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "25.5.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/three": "^0.183.1",
		"@vitest/coverage-v8": "^4.1.0",
		"concurrently": "^9.2.1",
		"jsdom": "^29.0.0",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.56.0",
		"postcss": "8.5.8",
		"tailwindcss": "4.2.1",
		"typescript": "5.9.3",
		"vitest": "^4.1.0"
	}
}
