# Canonical app URL used for checkout success/cancel redirects in hosted environments.
APP_BASE_URL=http://localhost:3000

# Optional Google Search Console verification token for the root metadata.
GOOGLE_SITE_VERIFICATION=

# Clerk public key used by the Next.js app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public sign-in route used by Clerk OAuth callbacks.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Clerk secret key used by server routes and middleware.
CLERK_SECRET_KEY=

# Clerk webhook signing secret used by /api/observability/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Hosted Convex dev deployment URL used by the web client.
# `bun run dev:convex` writes this plus `CONVEX_DEPLOYMENT` into `.env.local`.
NEXT_PUBLIC_CONVEX_URL=

# Optional Convex HTTP-actions URL used for observability ingest and incident
# status control when the deployment serves those endpoints on `.convex.site`.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Shared secret used by the Next.js app to authenticate error-ingest requests
# into the Convex observability HTTP endpoint. Generate a random value, for
# example: `openssl rand -hex 32`
OBSERVABILITY_INGEST_TOKEN=

# Shared secret that protects the maintainer-only incident status route at
# /api/observability/incidents/[incidentId]/status.
OBSERVABILITY_INCIDENT_CONTROL_TOKEN=

# Vercel webhook signing secret used by /api/observability/vercel.
OBSERVABILITY_VERCEL_WEBHOOK_SECRET=

# Telegram bot token used for production error alerts.
TELEGRAM_BOT_TOKEN=

# Telegram chat id the bot should post alerts into.
TELEGRAM_CHAT_ID=

# Test-only switch that enables the protected-shell error trigger used by the
# Playwright auth harness. Leave unset outside automated testing.
ENABLE_OBSERVABILITY_TEST_TRIGGER=

# Clerk frontend API / issuer domain used by Convex auth config.
CLERK_FRONTEND_API_URL=

# Optional comma-separated allowlist of trusted origins for Clerk auth validation.
# Defaults to APP_BASE_URL plus localhost origins outside production.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Stripe secret key used by checkout, webhook verification, and product scripts.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Optional Stripe price ID. If omitted, the app falls back to inline price_data.
# Leave this empty locally until your test Stripe account has a managed $500 price
# that matches the live early-member pricing contract.
STRIPE_PRICE_ID=

# Optional Stripe product ID emitted by the product creation script.
STRIPE_PRODUCT_ID=

# Required when the active public pricing offer is auto-applied at checkout.
# Set this to the Stripe promotion-code ID, not the human-readable code string.
STRIPE_PROMOTION_CODE_ID=

# Auphonic API key used by the lesson video publish pipeline.
AUPHONIC_API_KEY=

# Auphonic preset id used for lesson video processing.
AUPHONIC_PRESET_ID=

# Bunny Stream API key used by the lesson video publish pipeline.
BUNNY_STREAM_API_KEY=

# Bunny Stream library id used by the lesson video publish pipeline.
BUNNY_STREAM_LIBRARY_ID=

# GitHub token used by the local starter repo invite/sync/reset scripts.
GITHUB_STARTER_REPO_TOKEN=

# Optional explicit Python binary for the local silence-cut stage. Defaults to `.venv-video/bin/python`, then `python3.11`.
VIDEO_PIPELINE_PYTHON_BIN=

# Optional codex binary path for app-server routes. Defaults to `codex` on PATH.
CODEX_BINARY=

# Optional explicit flag for enabling the Codex app-server integration in this deployment.
# Defaults to enabled outside Vercel and disabled on Vercel unless set to `true`.
CODEX_APP_SERVER_ENABLED=

# Optional root directory for per-user Codex app-server state.
CODEX_APP_SERVER_HOME_ROOT=

# Optional default model for Codex generation.
CODEX_APP_SERVER_MODEL=

# Optional timeout in milliseconds for Codex generation turns.
CODEX_APP_SERVER_TIMEOUT_MS=

# Optional QA helper scope for Clerk test-user scripts.
CLERK_TEST_USER_SCOPE=

# Optional QA helper course slug for entitled-user preparation script.
QA_COURSE_SLUG=
