{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/app/*": ["./src/app/*"],
			"@/components/*": ["./src/components/*"],
			"@/config/*": ["./src/config/*"],
			"@/content/*": ["./src/content/*"],
			"@/convex/*": ["./convex/*"],
			"@/data/*": ["./src/data/*"],
			"@/hooks/*": ["./src/hooks/*"],
			"@/lib/*": ["./src/lib/*"],
			"@/platform/*": ["./src/platform/*"],
			"@/scripts/*": ["./scripts/*"],
			"@/*": ["./src/*", "./*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"next-env.d.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", "scripts/vendor/for_youtube/**"]
}
