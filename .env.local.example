# Clerk public key used by the Next.js app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key used by server routes and middleware.
CLERK_SECRET_KEY=

# Convex deployment URL used by the web client.
NEXT_PUBLIC_CONVEX_URL=

# Clerk frontend API / issuer domain used by Convex auth config.
CLERK_FRONTEND_API_URL=

# Stripe secret key used by checkout, webhook verification, and product scripts.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Optional Stripe price ID. If omitted, the app falls back to inline price_data.
STRIPE_PRICE_ID=

# Optional Stripe product ID emitted by the product creation script.
STRIPE_PRODUCT_ID=

# Optional Build lesson starter-template repo. When empty, the 3.1 template CTA stays hidden.
NEXT_PUBLIC_SHIP_BY_SUNDAY_TEMPLATE_REPO_URL=

# Optional codex binary path for app-server routes. Defaults to `codex` on PATH.
CODEX_BINARY=

# Optional root directory for per-user Codex app-server state.
CODEX_APP_SERVER_HOME_ROOT=

# Optional default model for Codex generation.
CODEX_APP_SERVER_MODEL=

# Optional timeout in milliseconds for Codex generation turns.
CODEX_APP_SERVER_TIMEOUT_MS=
